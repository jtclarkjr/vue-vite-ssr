{
  "extends": ["@vue/tsconfig/tsconfig.dom.json", "./.void/tsconfig.json"],
  "include": [
    "env.d.ts",
    "src/**/*",
    "src/**/*.vue",
    "pages/**/*",
    "routes/**/*.ts",
    "middleware/**/*.ts",
    "db/**/*.ts"
  ],
  "exclude": ["src/**/__tests__/*", "**/*.spec.ts"],
  "compilerOptions": {
    "types": ["void/env"],

    // Extra safety for array and object lookups, but may have false positives.
    "noUncheckedIndexedAccess": true,

    // TypeScript replaces inherited paths, so retain Void's generated aliases.
    "paths": {
      "@/*": ["./src/*"],
      "void/db": ["./.void/db.d.ts"],
      "@schema": ["./db/schema.ts"],
      "@schema/*": ["./db/schema/*"],
      "void/routes": ["./.void/routes.d.ts"]
    },

    // Keep incremental type-check metadata out of the root directory.
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo"
  }
}
