{
  "name": "vue-vite-ssr",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp run build:ssr",
    "prebuild": "vp exec void prepare && vp check && vp test run",
    "build:ssr": "vp build",
    "start": "vp preview --host 0.0.0.0",
    "preview:ssr": "vp run build:ssr && vp run start",
    "test": "vp test run",
    "test:unit": "vp test run --passWithNoTests",
    "lint": "vp lint . --fix",
    "lint:check": "vp lint .",
    "format": "vp fmt .",
    "format:check": "vp fmt --check .",
    "check": "vp check",
    "prepare": "vp config && vp exec void prepare"
  },
  "dependencies": {
    "@jtclarkjr/component-library-vue": "^0.4.2",
    "@void/vue": "1.1.11",
    "sass": "^1.105.1",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.5",
    "@types/bun": "^1.4.2",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "hono": "^4.13.13",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vite-plus": "^1.2.0",
    "void": "1.1.11"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24.21.0"
  },
  "packageManager": "bun@1.3.14"
}
