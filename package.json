{
  "name": "vue-vite-ssr",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run server/dev.ts",
    "dev:spa": "vp dev",
    "build": "vp run prebuild && vp run build:ssr",
    "prebuild": "vp check && vp test run",
    "build:client": "vp build --outDir dist/client",
    "build:server": "vp build --ssr src/entry-server.ts --outDir dist/server",
    "build:ssr": "vp run build:client && vp run build:server",
    "start": "NODE_ENV=production bun run server/production.ts",
    "preview:ssr": "vp run build:ssr && vp run start",
    "test": "vp test run",
    "test:unit": "vp test run --passWithNoTests",
    "test:storybook": "vp test run --config vitest.storybook.config.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "type-check": "vue-tsc --build",
    "lint": "vp lint . --fix",
    "lint:check": "vp lint .",
    "format": "vp fmt .",
    "format:check": "vp fmt --check .",
    "prepare": "vp config"
  },
  "dependencies": {
    "devalue": "^5.9.4",
    "pinia": "^4.0.3",
    "reka-ui": "^2.10.5",
    "sass": "^1.105.1",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "unplugin-vue-router": "^0.19.2",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-vitest": "^10.6.1",
    "@storybook/vue3-vite": "^10.6.1",
    "@tsconfig/node24": "^24.0.5",
    "@types/bun": "^1.4.2",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24.19.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/browser-playwright": "^4.1.11",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.63.0",
    "storybook": "^10.6.1",
    "typescript": "~6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vite-plus": "1.0.0",
    "vue-tsc": "^3.3.12"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "packageManager": "bun@1.3.14"
}
